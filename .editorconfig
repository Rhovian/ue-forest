root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cc,cpp,cxx,h,hh,hpp,hxx,cs,ini,uproject}]
indent_style = tab

[*.py]
indent_style = space
indent_size = 4

[scripts/editor-py]
indent_style = space
indent_size = 4

[*.sh]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
