#!/usr/bin/env python3
"""Capture the named review views (lead only; needs the open editor).

    scripts/review/capture OUT [VIEW...]   write OUT/<view>.png for every pose in poses.py, or only the named ones

OUT is conventionally Forest/Saved/Reviews/<issue>/<before|after|baseline>. Any agent may read the PNGs.
"""
import json
import os
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
SCRIPTS = os.path.dirname(HERE)
FOV = 90
# s for Landscape Grass to fill in around a new pose: it builds on the editor's tick after the camera moves, so a capture
# straight after the move showed the old or an empty floor (#117).
GRASS_SETTLE = 25

if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
    sys.exit(__doc__)
out, only = sys.argv[1], set(sys.argv[2:])
os.makedirs(out, exist_ok=True)
printed = subprocess.run([os.path.join(SCRIPTS, "editor-py"), os.path.join(HERE, "prepare.py")],
                         check=True, capture_output=True, text=True).stdout
cameras = json.loads(printed.strip().splitlines()[-1])
unknown = only - cameras.keys()
if unknown:
    sys.exit(f"unknown views: {sorted(unknown)}")
no_overlay = {"gridSpacing": 0, "gridExtent": 0, "gridHeight": 0, "maxLabelDistance": 0,
              "classFilter": {"refPath": ""}, "maxLabels": 0}
for name, camera in cameras.items():
    if only and name not in only:
        continue
    arguments = {
        "captureTransform": {
            "location": {axis: camera[axis] for axis in "xyz"},
            "rotation": {"pitch": camera["pitch"], "yaw": camera["yaw"], "roll": 0},
            "scale": {"x": 1, "y": 1, "z": 1},
        },
        "annotations": no_overlay,
    }
    # Twice: particle distance culling reads the last rendered view, which only moves to the pose after the first call
    # has returned and the viewport has drawn (scripts/review/warm.py).
    for settle in (GRASS_SETTLE, 0):
        subprocess.run([os.path.join(SCRIPTS, "editor-py"), os.path.join(HERE, "warm.py"), json.dumps(camera)],
                       check=True, capture_output=True)
        time.sleep(settle)
    path = os.path.join(out, f"{name}.png")
    pending = path + ".tmp"  # a rejected capture must not replace an earlier one
    reply = subprocess.run([os.path.join(SCRIPTS, "editor-mcp"), "-o", pending, "EditorToolset.EditorAppToolset",
                            "CaptureViewport", json.dumps(arguments)], check=True, capture_output=True, text=True).stdout
    fov = json.loads(reply)["returnValue"]["cameraFOV"]
    if round(fov) != FOV:  # CaptureViewport keeps the viewport's own FOV; poses assume the walker's
        os.remove(pending)
        sys.exit(f"viewport FOV is {fov}, not {FOV}: set the level viewport's field of view to {FOV} and rerun")
    os.replace(pending, path)
    print(path)
