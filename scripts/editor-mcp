#!/usr/bin/env python3
"""Call the open editor's MCP server (lead only; see AGENTS.md).

    scripts/editor-mcp                          list toolsets
    scripts/editor-mcp TOOLSET                  describe a toolset's tools
    scripts/editor-mcp TOOLSET TOOL [JSON]      call a tool with JSON arguments
    scripts/editor-mcp -o FILE TOOLSET TOOL ... write a returned image (e.g. CaptureViewport) to FILE

Works whether or not this session's MCP client connected at startup. Prints the tool's text result.
"""
import base64
import json
import os
import signal
import sys
import urllib.request

URL = os.environ.get("EDITOR_MCP_URL", "http://127.0.0.1:8000/mcp")
# s of wall-clock time each request may take, headers to last byte. Without a limit, a CaptureViewport the server never
# answered held the capture run for 7.5 hours while the editor itself kept running (#165). A socket timeout alone would
# not do: it bounds each read, so a server trickling stream bytes could still hold a request forever.
TIMEOUT = float(os.environ.get("EDITOR_MCP_TIMEOUT", "120"))
if not TIMEOUT > 0:  # setitimer(0) disarms the timer: no bound at all
    sys.exit(f"EDITOR_MCP_TIMEOUT must be a positive number of seconds, not {TIMEOUT:g}")
session = None


def rpc(method, params=None):
    global session
    body = {"jsonrpc": "2.0", "method": method}
    if params is not None:
        body["params"] = params
    if not method.startswith("notifications/"):
        body["id"] = 1
    headers = {"Content-Type": "application/json", "Accept": "application/json, text/event-stream"}
    if session:
        headers["Mcp-Session-Id"] = session

    def hung(*_):
        sys.exit(f"{method}: no reply from {URL} within {TIMEOUT:g}s; the MCP server is hung (scripts/editor-py may"
                 " still work)")

    signal.signal(signal.SIGALRM, hung)
    signal.setitimer(signal.ITIMER_REAL, TIMEOUT)
    try:
        with urllib.request.urlopen(urllib.request.Request(URL, json.dumps(body).encode(), headers)) as response:
            session = session or response.headers.get("Mcp-Session-Id")
            text = response.read().decode()
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
    if "id" not in body:
        return None
    data = [line[5:] for line in text.splitlines() if line.startswith("data:")]
    reply = json.loads(data[-1] if data else text)
    if "error" in reply:
        sys.exit(json.dumps(reply["error"]))
    return reply["result"]


args = sys.argv[1:]
image_path = None
if args[:1] == ["-o"] and len(args) > 1:
    image_path, args = args[1], args[2:]
if len(args) > 3 or args[:1] in (["-h"], ["--help"]):
    sys.exit(__doc__)
try:
    rpc("initialize", {"protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "editor-mcp", "version": "1"}})
except OSError as error:
    sys.exit(f"editor MCP not reachable at {URL} ({error}); run scripts/editor.sh open")
rpc("notifications/initialized")
if not args:
    result = rpc("tools/call", {"name": "list_toolsets", "arguments": {}})
elif len(args) == 1:
    result = rpc("tools/call", {"name": "describe_toolset", "arguments": {"toolset_name": args[0]}})
else:
    arguments = json.loads(args[2]) if len(args) == 3 else {}
    result = rpc("tools/call", {"name": "call_tool", "arguments": {"toolset_name": args[0], "tool_name": args[1], "arguments": arguments}})
text = "\n".join(item.get("text", json.dumps(item)) for item in result.get("content", []))
if image_path:
    reply = json.loads(text)
    image = reply.get("returnValue", reply).get("image") or {}
    if not image.get("data"):
        sys.exit(f"no image in the result:\n{text[:2000]}")
    with open(image_path, "wb") as out:
        out.write(base64.b64decode(image.pop("data")))
    text = json.dumps(reply)
print(text)
sys.exit(1 if result.get("isError") else 0)
