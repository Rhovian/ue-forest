#!/usr/bin/env python3
"""Run Python in the open editor (lead only; see AGENTS.md).

    scripts/editor-py file.py [args...]  run a file; args reach it as sys.argv[1:]
    scripts/editor-py - <<'PY'     run stdin
    scripts/editor-py -e EXPR      print one expression

Drops the script into Forest/Saved/EditorPy/in, where Content/Python/init_unreal.py runs it on the
editor's game thread, and prints what it wrote to out/.
"""
import json
import os
import sys
import time
import uuid

ROOT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "Forest", "Saved", "EditorPy")
TIMEOUT = float(os.environ.get("EDITOR_PY_TIMEOUT", "600"))

if len(sys.argv) < 2:
    sys.exit(__doc__)
if sys.argv[1] == "-e":
    source = f"print({' '.join(sys.argv[2:])})"
elif sys.argv[1] == "-":
    source = sys.stdin.read()
else:
    with open(sys.argv[1]) as script:
        here = os.path.dirname(os.path.abspath(sys.argv[1]))
        # argv for the script, and its folder on sys.path so it can import sibling helper modules
        source = script.read()
        prelude = f"import sys\nsys.argv = {sys.argv[1:]!r}\nsys.path.insert(0, {here!r})\n"
        if "# editor-py: fresh-siblings\n" in source:
            # CPython importlib/_bootstrap.py:_find_and_load consults sys.modules before sys.path;
            # invalidate_caches() alone cannot replace an already imported module or its aliases.
            siblings = [os.path.splitext(name)[0] for name in os.listdir(here) if name.endswith(".py")]
            prelude += f"for _sibling in {siblings!r}:\n    sys.modules.pop(_sibling, None)\n"
        source = prelude + source

deadline = time.time() + TIMEOUT
while not os.path.isdir(os.path.join(ROOT, "in")):  # created by init_unreal.py once the editor is up
    if time.time() > deadline:
        sys.exit(f"{ROOT}/in does not exist; is the editor open?")
    time.sleep(0.5)

name = uuid.uuid4().hex
# Existing callers remain synchronous. Scripts explicitly marked deferred may finish on later
# editor ticks: init_unreal.py:_run otherwise returns as soon as their source finishes executing.
deferred = "# editor-py: deferred\n" in source
deferred_out = os.path.join(ROOT, "out", name + ".deferred.json")
if deferred:
    source = f"EDITOR_PY_DEFERRED_RESULT = {deferred_out!r}\n" + source
tmp = os.path.join(ROOT, "in", name + ".tmp")
with open(tmp, "w") as f:
    f.write(source)
os.replace(tmp, os.path.join(ROOT, "in", name + ".py"))  # the editor only picks up complete .py files

out = os.path.join(ROOT, "out", name + ".json")
while not os.path.exists(out):
    if time.time() > deadline:
        sys.exit(f"no result after {TIMEOUT:.0f}s; is the editor open? (request left in {ROOT}/in)")
    time.sleep(0.1)
with open(out) as f:
    result = json.load(f)
os.remove(out)
marker = "__EDITOR_PY_DEFERRED__\n"
if deferred and result["ok"] and result["output"].endswith(marker):
    print(result["output"][:-len(marker)], end="", flush=True)
    while not os.path.exists(deferred_out):
        if time.time() > deadline:
            sys.exit(f"no deferred result after {TIMEOUT:.0f}s; PCG may still be running; do not restart it")
        time.sleep(0.1)
    with open(deferred_out) as f:
        result = json.load(f)
    os.remove(deferred_out)
print(result["output"], end="")
sys.exit(0 if result["ok"] else 1)
