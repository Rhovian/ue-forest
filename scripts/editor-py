#!/usr/bin/env python3
"""Run Python in the open editor (lead only; see AGENTS.md).

    scripts/editor-py file.py      run a file
    scripts/editor-py - <<'PY'     run stdin
    scripts/editor-py -e EXPR      print one expression

Drops the script into MyProject/Saved/EditorPy/in, where Content/Python/init_unreal.py runs it on the
editor's game thread, and prints what it wrote to out/.
"""
import json
import os
import sys
import time
import uuid

ROOT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "MyProject", "Saved", "EditorPy")
TIMEOUT = float(os.environ.get("EDITOR_PY_TIMEOUT", "600"))

if len(sys.argv) < 2:
    sys.exit(__doc__)
if sys.argv[1] == "-e":
    source = f"print({' '.join(sys.argv[2:])})"
else:
    source = sys.stdin.read() if sys.argv[1] == "-" else open(sys.argv[1]).read()

deadline = time.time() + TIMEOUT
while not os.path.isdir(os.path.join(ROOT, "in")):  # created by init_unreal.py once the editor is up
    if time.time() > deadline:
        sys.exit(f"{ROOT}/in does not exist; is the editor open?")
    time.sleep(0.5)

name = uuid.uuid4().hex
tmp = os.path.join(ROOT, "in", name + ".tmp")
with open(tmp, "w") as f:
    f.write(source)
os.replace(tmp, os.path.join(ROOT, "in", name + ".py"))  # the editor only picks up complete .py files

out = os.path.join(ROOT, "out", name + ".json")
while not os.path.exists(out):
    if time.time() > deadline:
        sys.exit(f"no result after {TIMEOUT:.0f}s; is the editor open? (request left in {ROOT}/in)")
    time.sleep(0.1)
with open(out) as f:
    result = json.load(f)
os.remove(out)
print(result["output"], end="")
sys.exit(0 if result["ok"] else 1)
